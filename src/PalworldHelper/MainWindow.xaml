<Window x:Class="PalworldHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PalworldHelper" Height="860" Width="1100" MinHeight="720" MinWidth="920" WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#B91C1C" BorderBrush="#FCA5A5" BorderThickness="2" CornerRadius="8" Padding="18" Margin="0,0,0,16">
      <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="⚠ THIS PROJECT IS CREATED BY AI ⚠" Foreground="White" FontSize="28" FontWeight="ExtraBold" TextAlignment="Center"/>
        <TextBlock Text="AI designs, writes, documents, tests, and maintains the project. The human owner reviews and approves the results." Foreground="White" FontSize="16" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <TextBlock Text="This is not presented as a human-developed software project." Foreground="#FEE2E2" FontSize="14" FontWeight="SemiBold" FontStyle="Italic" TextAlignment="Center" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="1" Margin="0,0,0,16"><TextBlock Text="PalworldHelper" FontSize="34" FontWeight="Bold"/><TextBlock Text="Native Windows helper with server profiles, parsed save data, and breeding chains." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
    <TabControl Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}">
      <TabItem Header="Server"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0"><TextBlock Text="Server Profiles" FontSize="20" FontWeight="SemiBold"/><ListBox x:Name="ProfilesList" Height="360" Margin="0,12,0,8" SelectionChanged="ProfilesList_SelectionChanged" DisplayMemberPath="Name"/><WrapPanel><Button Content="New" Click="NewProfile_Click"/><Button Content="Delete" Click="DeleteProfile_Click" Background="#FF8796"/></WrapPanel></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Connection Settings" FontSize="20" FontWeight="SemiBold"/><Label Content="Profile name"/><TextBox x:Name="ProfileName"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel><Label Content="Host / IP"/><TextBox x:Name="Host"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><Label Content="SSH port"/><TextBox x:Name="Port" Text="22"/></StackPanel></Grid><Label Content="Username"/><TextBox x:Name="Username"/><Label Content="Authentication"/><ComboBox x:Name="Authentication" SelectionChanged="Authentication_SelectionChanged"><ComboBoxItem Content="Password" IsSelected="True"/><ComboBoxItem Content="SSH key"/></ComboBox><StackPanel x:Name="PasswordPanel"><Label Content="Password (encrypted locally with Windows DPAPI)"/><PasswordBox x:Name="Password"/></StackPanel><StackPanel x:Name="KeyPanel" Visibility="Collapsed"><Label Content="Private SSH key path"/><DockPanel><Button DockPanel.Dock="Right" Content="…" Margin="8,0,0,0" Click="PickKey_Click"/><TextBox x:Name="PrivateKeyPath"/></DockPanel></StackPanel><Label Content="Remote path to Level.sav"/><DockPanel><Button DockPanel.Dock="Right" Content="Find automatically" Margin="8,0,0,0" Click="FindRemoteSave_Click"/><TextBox x:Name="RemoteSavePath" ToolTip="May be left empty. The application can search the server for Level.sav automatically."/></DockPanel><Label Content="Player name"/><TextBox x:Name="PlayerName" Text="Lanessear"/><WrapPanel Margin="0,10,0,0"><Button Content="Save" Click="SaveProfile_Click"/><Button Content="Test connection" Click="TestConnection_Click"/><Button Content="Download save" Click="DownloadSave_Click"/></WrapPanel><TextBlock x:Name="ServerStatus" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel>
      </Grid></ScrollViewer></TabItem>
      <TabItem Header="Breeding Chain"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
          <DockPanel><TextBlock Text="Breeding Data" FontSize="20" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="JSON format info" Click="ShowBreedingJsonInfo_Click" Padding="12,5"/></DockPanel>
          <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Text="The release includes a replaceable Default JSON next to the program. If a selected custom file is missing or deleted, PalworldHelper automatically falls back to Default."/>
          <DockPanel Margin="0,10,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Use Default" Click="UseBundledBreedingData_Click"/><Button Content="Select JSON" Margin="8,0,0,0" Click="PickBreedingJson_Click"/></StackPanel><TextBox x:Name="BreedingJsonPath" IsReadOnly="True"/></DockPanel>
          <DockPanel Margin="0,8,0,0"><Border x:Name="BreedingDataKindBadge" DockPanel.Dock="Left" Background="#2563EB" CornerRadius="5" Padding="8,3" Margin="0,0,8,0"><TextBlock x:Name="BreedingDataKindText" Text="Default" Foreground="White" FontWeight="Bold"/></Border><TextBlock x:Name="BreedingStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><Label Content="Optional owned source Pal"/><ComboBox x:Name="StartPal" IsEditable="True" IsTextSearchEnabled="True"/></StackPanel><StackPanel Grid.Column="1" Margin="14,0,0,0"><Label Content="Desired child Pal"/><ComboBox x:Name="TargetPal" IsEditable="True" IsTextSearchEnabled="True"/></StackPanel><StackPanel Grid.Column="2" Margin="14,0,0,0"><Label Content="Desired passive skills"/><DockPanel><Button DockPanel.Dock="Right" Content="Add" Padding="10,5" Margin="8,0,0,0" Click="AddPassiveSkill_Click"/><ComboBox x:Name="PassiveSkillPicker" IsEditable="True" IsTextSearchEnabled="True" DisplayMemberPath="DisplayName"/></DockPanel><WrapPanel x:Name="PassiveSkillTags" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="3" Content="Find best chain" VerticalAlignment="Bottom" Margin="14,0,0,0" Click="FindPath_Click"/></Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox x:Name="ResultList" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}" FontSize="16" Padding="10" SelectionChanged="ResultList_SelectionChanged"/><GroupBox Grid.Column="1" Header="Best parent details" Margin="14,0,0,0"><TextBox x:Name="ParentDetails" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" FontFamily="Consolas"/></GroupBox></Grid>
      </Grid></TabItem>
      <TabItem Header="Save Data"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Palworld save parser" FontSize="20" FontWeight="SemiBold"/><TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Text="Select Level.sav locally or download it from a server. The selected local path is saved and restored when the program starts again."/><DockPanel Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="Select Level.sav" Margin="8,0,0,0" Click="PickLocalSave_Click"/><TextBox x:Name="LocalSavePath" IsReadOnly="True"/></DockPanel><TextBlock x:Name="SaveStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,12"><Border Background="{StaticResource Panel2}" CornerRadius="8" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="Players" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SavePlayerCount" Text="—" FontSize="28" FontWeight="Bold"/></StackPanel></Border><Border Background="{StaticResource Panel2}" CornerRadius="8" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="Pals" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SavePalCount" Text="—" FontSize="28" FontWeight="Bold"/></StackPanel></Border><Border Background="{StaticResource Panel2}" CornerRadius="8" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="Species" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SaveSpeciesCount" Text="—" FontSize="28" FontWeight="Bold"/></StackPanel></Border><Border Background="{StaticResource Panel2}" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="Passive skills" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SavePassiveCount" Text="—" FontSize="28" FontWeight="Bold"/></StackPanel></Border></UniformGrid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.9*"/></Grid.ColumnDefinitions><GroupBox Header="Players" Margin="0,0,8,0"><DockPanel><TextBlock DockPanel.Dock="Bottom" x:Name="SaveOwnerFilterStatus" Text="Click a player to filter owned Pals." Foreground="{StaticResource Muted}" Margin="8,6"/><ListView x:Name="SavePlayersList" SelectionChanged="SavePlayersList_SelectionChanged" GridViewColumnHeader.Click="GridViewColumnHeader_Click"><ListView.View><GridView><GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="180"/><GridViewColumn Header="Level" DisplayMemberBinding="{Binding Level}" Width="70"/><GridViewColumn Header="UID" DisplayMemberBinding="{Binding PlayerUid}" Width="260"/></GridView></ListView.View></ListView></DockPanel></GroupBox><GroupBox Grid.Column="1" Header="Owned Pals" Margin="8,0,0,0"><DockPanel><Button DockPanel.Dock="Bottom" Content="Show all owners" Click="ShowAllOwners_Click" HorizontalAlignment="Left" Padding="10,5" Margin="8,6"/><ListView x:Name="SavePalsList" GridViewColumnHeader.Click="GridViewColumnHeader_Click"><ListView.View><GridView><GridViewColumn Header="Species" DisplayMemberBinding="{Binding Species}" Width="140"/><GridViewColumn Header="Nickname" DisplayMemberBinding="{Binding Nickname}" Width="130"/><GridViewColumn Header="Owner" DisplayMemberBinding="{Binding Owner}" Width="140"/><GridViewColumn Header="Level" DisplayMemberBinding="{Binding Level}" Width="60"/><GridViewColumn Header="Gender" DisplayMemberBinding="{Binding Gender}" Width="80"/><GridViewColumn Header="Passives" DisplayMemberBinding="{Binding PassiveSkills}" Width="360"/></GridView></ListView.View></ListView></DockPanel></GroupBox></Grid>
        <Expander Grid.Row="3" Header="Technical details" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><GroupBox Header="File and parser information" Margin="0,0,8,0"><TextBox x:Name="SaveMetadata" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="120" Padding="8" FontFamily="Consolas"/></GroupBox><GroupBox Header="Header / hex preview" Grid.Column="1" Margin="8,0,0,0"><TextBox x:Name="SaveHexPreview" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MinHeight="120" Padding="8" FontFamily="Consolas"/></GroupBox></Grid></Expander>
      </Grid></TabItem>
      <TabItem Header="Maintenance"><StackPanel Margin="20"><TextBlock Text="Updates and removal" FontSize="20" FontWeight="SemiBold"/><TextBlock Margin="0,8,0,14" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Text="Updates are downloaded from the latest GitHub release. Files no longer used by the new version are moved to a dated archive under %LOCALAPPDATA%\PalworldHelper\obsolete instead of being deleted immediately."/><WrapPanel><Button Content="Check for updates" Click="CheckForUpdates_Click"/><Button Content="Uninstall PalworldHelper" Margin="10,0,0,0" Background="#FF8796" Click="Uninstall_Click"/></WrapPanel><TextBlock x:Name="MaintenanceStatus" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></StackPanel></TabItem>
    </TabControl>
    <DockPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock DockPanel.Dock="Left" Foreground="{StaticResource Muted}" Text="PalworldHelper v0.6 · Settings are stored under %LOCALAPPDATA%\PalworldHelper"/><TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Muted}" Text="Portable app folder; data and parser helper remain replaceable."/></DockPanel>
  </Grid>
</Window>
