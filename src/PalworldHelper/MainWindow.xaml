<Window x:Class="PalworldHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PalworldHelper"
        Height="900"
        Width="1180"
        MinHeight="760"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="#B91C1C"
            BorderBrush="#FCA5A5"
            BorderThickness="2"
            CornerRadius="12"
            Padding="18"
            Margin="0,0,0,16">
      <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="⚠ THIS PROJECT IS CREATED BY AI ⚠"
                   Foreground="White"
                   FontSize="26"
                   FontWeight="ExtraBold"
                   TextAlignment="Center"/>
        <TextBlock Text="AI designs, writes, documents, tests, and maintains the project. The human owner reviews and approves the results."
                   Foreground="White"
                   FontSize="15"
                   FontWeight="Bold"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"/>
        <TextBlock Text="This is not presented as a human-developed software project."
                   Foreground="#FEE2E2"
                   FontSize="14"
                   FontWeight="SemiBold"
                   FontStyle="Italic"
                   TextAlignment="Center"
                   Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="PalworldHelper" FontSize="36" FontWeight="Bold"/>
        <TextBlock Text="Import a save, inspect owned Pals, and plan cleaner breeding chains."
                   Foreground="{StaticResource Muted}"
                   FontSize="15"
                   Margin="0,4,0,0"/>
        <WrapPanel Margin="0,12,0,0">
          <Border Style="{StaticResource Pill}">
            <TextBlock Text="Local-first"/>
          </Border>
          <Border Style="{StaticResource Pill}" Background="{StaticResource PrimarySoft}">
            <TextBlock Text="Save-aware breeding"/>
          </Border>
          <Border Style="{StaticResource Pill}" Background="{StaticResource SuccessSoft}">
            <TextBlock Text="Cached parsing"/>
          </Border>
        </WrapPanel>
      </StackPanel>
      <Border Grid.Column="1"
              Style="{StaticResource Card}"
              Background="{StaticResource AccentSoft}"
              Padding="14,10"
              VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="Command center"
                     FontWeight="SemiBold"/>
          <TextBlock Text="Start with a save, then plan breeding."
                     Foreground="{StaticResource Muted}"
                     Margin="0,3,0,6"/>
          <WrapPanel>
            <Button Content="Load save"
                    Style="{StaticResource PrimaryButton}"
                    Click="GoToSaveData_Click"/>
            <Button Content="Plan breeding"
                    Style="{StaticResource SecondaryButton}"
                    Click="GoToBreeding_Click"/>
            <Button Content="Debug"
                    Style="{StaticResource SecondaryButton}"
                    Click="GoToMaintenance_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>

    <UniformGrid Grid.Row="2"
                 Columns="4"
                 Margin="0,0,0,16">
      <Border Style="{StaticResource DashboardCard}">
        <StackPanel>
          <TextBlock Text="Save source" Foreground="{StaticResource Muted}"/>
          <TextBlock x:Name="DashboardSaveStatus"
                     Text="No save loaded"
                     FontSize="18"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Margin="0,4,0,0"/>
          <TextBlock x:Name="DashboardCacheStatus"
                     Text="Select or auto-find Level.sav"
                     Foreground="{StaticResource Muted}"
                     TextWrapping="Wrap"
                     Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource DashboardCard}">
        <StackPanel>
          <TextBlock Text="Owner focus" Foreground="{StaticResource Muted}"/>
          <TextBlock x:Name="DashboardOwnerStatus"
                     Text="All owners"
                     FontSize="18"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Margin="0,4,0,0"/>
          <TextBlock Text="Click a player to filter owned Pals."
                     Foreground="{StaticResource Muted}"
                     TextWrapping="Wrap"
                     Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource DashboardCard}">
        <StackPanel>
          <TextBlock Text="Breeding data" Foreground="{StaticResource Muted}"/>
          <TextBlock x:Name="DashboardBreedingStatus"
                     Text="Loading default data"
                     FontSize="18"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Margin="0,4,0,0"/>
          <TextBlock Text="Default data is usually enough."
                     Foreground="{StaticResource Muted}"
                     TextWrapping="Wrap"
                     Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource DashboardCard}" Margin="0">
        <StackPanel>
          <TextBlock Text="Next best action" Foreground="{StaticResource Muted}"/>
          <TextBlock x:Name="DashboardNextAction"
                     Text="Load a save or plan without restrictions."
                     FontSize="18"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Margin="0,4,0,0"/>
          <Button Content="Open Breeding Chain"
                  Style="{StaticResource SecondaryButton}"
                  Click="GoToBreeding_Click"/>
        </StackPanel>
      </Border>
    </UniformGrid>

    <TabControl x:Name="MainTabs"
                Grid.Row="3"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border}">
      <TabItem Header="Save Data">
        <Grid Margin="20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Your Palworld Save" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Margin="0,6,0,0"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource Muted}"
                         Text="Most players only need to select their local Level.sav. If the matching Players folder is nearby, PalworldHelper also reads party and Dimensional Pal Storage ownership. Server download is optional and mostly useful for server owners."/>
              <Border Background="{StaticResource Panel2}"
                      CornerRadius="8"
                      Padding="12"
                      Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="How to find your player data"
                             FontWeight="SemiBold"/>
                  <TextBlock Margin="0,6,0,0"
                             TextWrapping="Wrap"
                             Foreground="{StaticResource Muted}"
                             Text="Select the save file named Level.sav. For local worlds it is usually under %LOCALAPPDATA%\Pal\Saved\SaveGames. For shared server saves, ask the server owner for Level.sav plus the Players folder from the same save directory."/>
                  <TextBlock Margin="0,6,0,0"
                             TextWrapping="Wrap"
                             Foreground="{StaticResource Muted}"
                             Text="Tip: keep Level.sav and the Players folder together before selecting the save. Without Players files, ownership details may be incomplete."/>
                </StackPanel>
              </Border>
              <DockPanel Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Margin="8,0,0,0">
		                  <Button Content="Find automatically"
                              Style="{StaticResource PrimaryButton}"
		                          Click="FindLocalSave_Click"/>
		                  <Button Content="Refresh save data"
                              Style="{StaticResource SecondaryButton}"
		                          Click="RefreshSaveData_Click"/>
		                  <Button Content="Select Level.sav"
                              Style="{StaticResource SecondaryButton}"
		                          Click="PickLocalSave_Click"/>
                </StackPanel>
                <TextBox x:Name="LocalSavePath" IsReadOnly="True"/>
              </DockPanel>
              <TextBlock x:Name="SaveStatus"
                         Foreground="{StaticResource Muted}"
                         TextWrapping="Wrap"
                         Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <UniformGrid Grid.Row="1" Columns="4" Margin="0,14,0,14">
            <Border Style="{StaticResource StatCard}">
              <StackPanel>
                <TextBlock Text="Owners in view" Foreground="{StaticResource Muted}"/>
                <TextBlock x:Name="SavePlayerCount" Text="—" FontSize="28" FontWeight="Bold"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
              <StackPanel>
                <TextBlock Text="Owned Pals" Foreground="{StaticResource Muted}"/>
                <TextBlock x:Name="SavePalCount" Text="—" FontSize="28" FontWeight="Bold"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
              <StackPanel>
                <TextBlock Text="Species" Foreground="{StaticResource Muted}"/>
                <TextBlock x:Name="SaveSpeciesCount" Text="—" FontSize="28" FontWeight="Bold"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="0">
              <StackPanel>
                <TextBlock Text="Passive Skills" Foreground="{StaticResource Muted}"/>
                <TextBlock x:Name="SavePassiveCount" Text="—" FontSize="28" FontWeight="Bold"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.05*"/>
              <ColumnDefinition Width="1.95*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Players">
              <DockPanel>
                <TextBlock DockPanel.Dock="Bottom"
                           x:Name="SaveOwnerFilterStatus"
                           Text="Click a player to filter owned Pals."
                           Foreground="{StaticResource Muted}"
                           Margin="8,8,8,0"/>
                <ListView x:Name="SavePlayersList"
                          SelectionChanged="SavePlayersList_SelectionChanged"
                          GridViewColumnHeader.Click="GridViewColumnHeader_Click">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="180"/>
                      <GridViewColumn Header="Level" DisplayMemberBinding="{Binding Level}" Width="70"/>
                      <GridViewColumn Header="UID" DisplayMemberBinding="{Binding PlayerUid}" Width="260"/>
                    </GridView>
                  </ListView.View>
                </ListView>
              </DockPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Owned Pals" Margin="14,0,0,0">
              <DockPanel>
                <Button DockPanel.Dock="Bottom"
                        Content="Show all owners"
                        Click="ShowAllOwners_Click"
                        HorizontalAlignment="Left"
                        Padding="10,5"
                        Margin="8,8,0,0"/>
                <ListView x:Name="SavePalsList"
                          GridViewColumnHeader.Click="GridViewColumnHeader_Click">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="Species" DisplayMemberBinding="{Binding Species}" Width="140"/>
                      <GridViewColumn Header="Nickname" DisplayMemberBinding="{Binding Nickname}" Width="130"/>
                      <GridViewColumn Header="Owner" DisplayMemberBinding="{Binding Owner}" Width="140"/>
                      <GridViewColumn Header="Storage" DisplayMemberBinding="{Binding Storage}" Width="150"/>
                      <GridViewColumn Header="Level" DisplayMemberBinding="{Binding Level}" Width="60"/>
                      <GridViewColumn Header="Gender" DisplayMemberBinding="{Binding Gender}" Width="80"/>
                      <GridViewColumn Header="Passives" DisplayMemberBinding="{Binding PassiveSkills}" Width="320"/>
                    </GridView>
                  </ListView.View>
                </ListView>
              </DockPanel>
            </GroupBox>
          </Grid>

          <Expander Grid.Row="3" Header="Technical details" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <GroupBox Header="File and parser information" Margin="0,0,8,0">
                <TextBox x:Name="SaveMetadata"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="120"
                         Padding="8"
                         FontFamily="Consolas"/>
              </GroupBox>
              <GroupBox Header="Header / hex preview" Grid.Column="1" Margin="8,0,0,0">
                <TextBox x:Name="SaveHexPreview"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="120"
                         Padding="8"
                         FontFamily="Consolas"/>
              </GroupBox>
            </Grid>
          </Expander>
        </Grid>
      </TabItem>

      <TabItem Header="Breeding Chain">
        <Grid Margin="20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel Margin="0,0,0,0">
                <Border x:Name="BreedingDataKindBadge"
                        DockPanel.Dock="Left"
                        Background="#2563EB"
                        CornerRadius="6"
                        Padding="8,3"
                        Margin="0,0,8,0">
                  <TextBlock x:Name="BreedingDataKindText"
                             Text="Default"
                             Foreground="White"
                             FontWeight="Bold"/>
                </Border>
                <TextBlock x:Name="BreedingStatus"
                           Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
              </DockPanel>

              <Expander Header="Advanced: breeding data source"
                        Margin="0,10,0,0"
                        IsExpanded="False">
                <StackPanel>
                  <TextBlock Text="The bundled default is normally correct. Use a custom JSON only when the game changes breeding rules or you are testing another dataset."
                             Foreground="{StaticResource Muted}"
                             TextWrapping="Wrap"
                             Margin="0,5,0,0"/>
                  <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                      <Button Content="JSON format info"
                              Click="ShowBreedingJsonInfo_Click"/>
                      <Button Content="Use Default"
                              Click="UseBundledBreedingData_Click"/>
                      <Button Content="Select JSON"
                              Click="PickBreedingJson_Click"/>
                    </StackPanel>
                    <TextBox x:Name="BreedingJsonPath" IsReadOnly="True"/>
                  </DockPanel>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel>
                <Label Content="Optional owned source Pal"/>
                <ComboBox x:Name="StartPal" IsEditable="True" IsTextSearchEnabled="True" DisplayMemberPath="DisplayName"/>
                <TextBlock Text="Leave empty to search from any available Pal."
                           Foreground="{StaticResource Muted}"
                           FontSize="12"
                           Margin="0,5,0,0"/>
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <Label Content="Desired child Pal"/>
                <ComboBox x:Name="TargetPal" IsEditable="True" IsTextSearchEnabled="True" DisplayMemberPath="DisplayName"/>
                <TextBlock Text="Pick the target first, then click a result for parent details."
                           Foreground="{StaticResource Muted}"
                           FontSize="12"
                           Margin="0,5,0,0"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Margin="14,0,0,0">
                <Label Content="Desired passive skills"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right"
                          Content="Add"
                          Padding="10,5"
                          Margin="8,0,0,0"
                          Click="AddPassiveSkill_Click"/>
                  <ComboBox x:Name="PassiveSkillPicker"
                            IsEditable="True"
                            IsTextSearchEnabled="True"
                            DisplayMemberPath="DisplayName"/>
                </DockPanel>
                <WrapPanel x:Name="PassiveSkillTags" Margin="0,8,0,0"/>
                <TextBlock x:Name="PassiveSkillLimitStatus"
                           Text="0/4 passive skills selected. Cleaner parents with fewer extra passives are ranked higher."
                           Foreground="{StaticResource Muted}"
                           FontSize="12"
                           Margin="0,5,0,0"/>
              </StackPanel>

              <StackPanel Grid.Column="3" Margin="14,0,0,0">
                <Label Content="Gender conversions"/>
                <ComboBox x:Name="GenderConversionBudget"
                          SelectedIndex="0">
                  <ComboBoxItem Content="0"/>
                  <ComboBoxItem Content="1"/>
                  <ComboBoxItem Content="2"/>
                </ComboBox>
                <TextBlock Text="Uses gender-change items when needed."
                           Foreground="{StaticResource Muted}"
                           FontSize="12"
                           Margin="0,5,0,0"/>
              </StackPanel>

              <Button Grid.Column="4"
                      Content="Find best chain"
                      VerticalAlignment="Top"
                      Margin="14,25,0,0"
                      Click="FindPath_Click"/>

              <Expander Grid.Row="1"
                        Grid.ColumnSpan="5"
                        Header="Saved breeding goals"
                        IsExpanded="True"
                        Margin="0,16,0,0">
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ListBox x:Name="BreedingWishlistList"
                           MinHeight="92"
                           MaxHeight="150"
                           SelectionChanged="BreedingWishlistList_SelectionChanged"/>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <Button Content="Save current goal"
                            Click="SaveBreedingGoal_Click"/>
                    <Button Content="Load selected"
                            Click="LoadBreedingGoal_Click"/>
                    <Button Content="Remove selected"
                            Background="#FF8796"
                            Click="RemoveBreedingGoal_Click"/>
                  </StackPanel>
                </Grid>
              </Expander>
              <Expander Grid.Row="2"
                        Grid.ColumnSpan="5"
                        Header="Passive inheritance notes"
                        Margin="0,12,0,0">
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap"
                           Text="Palworld combines both parents' passive skills, removes duplicates, then rolls how many parent passives the child inherits: 1 = 40%, 2 = 30%, 3 = 20%, 4 = 10%. A second roll can add random passives if empty slots remain. PalworldHelper ranks owned parent pairs by the estimated chance to hatch the exact desired passive set without extra random passives. Clean parents are better: together they should carry the desired passives and as few unwanted passives as possible. Duplicate passives on both parents do not improve the odds.&#x0a;&#x0a;Sources checked 2026-07-26: Palworld Wiki.gg – Breeding, section “Passing Down Passive Skills” (https://palworld.wiki.gg/wiki/Breeding); Palworld Wiki.gg – Passive Skills, section “Acquisition / Breeding” (https://palworld.wiki.gg/wiki/Passive_Skills)."/>
              </Expander>
            </Grid>
          </Border>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Breeding Chain Results">
              <ListBox x:Name="ResultList"
                       Background="{StaticResource Panel}"
                       Foreground="{StaticResource Text}"
                       BorderBrush="{StaticResource Border}"
                       FontSize="16"
                       Padding="10"
                       SelectionChanged="ResultList_SelectionChanged"/>
            </GroupBox>
            <GroupBox Grid.Column="1"
                      Header="Best Parent Details"
                      Margin="14,0,0,0">
              <TextBox x:Name="ParentDetails"
                       IsReadOnly="True"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       Padding="14"
                       FontSize="14"
                       Text="Click a breeding result to inspect owned parent candidates."/>
            </GroupBox>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Optional Server Import">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="310"/>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock Text="Saved server imports" FontSize="20" FontWeight="SemiBold"/>
                  <TextBlock Text="Optional profiles for people who can access a Palworld server via SFTP."
                             Foreground="{StaticResource Muted}"
                             TextWrapping="Wrap"
                             Margin="0,5,0,12"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                  <Button Content="New" Click="NewProfile_Click"/>
                  <Button Content="Delete" Click="DeleteProfile_Click" Background="#FF8796"/>
                </WrapPanel>
                <ListBox x:Name="ProfilesList"
                         SelectionChanged="ProfilesList_SelectionChanged"
                         DisplayMemberPath="Name"/>
              </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                  <TextBlock Text="Optional server download" FontSize="20" FontWeight="SemiBold"/>
                  <TextBlock Text="Use this only if you own or administer a server, or if the owner gave you SFTP access. Everyone else can stay on Save Data and select Level.sav locally."
                             Foreground="{StaticResource Muted}"
                             TextWrapping="Wrap"
                             Margin="0,5,0,12"/>
                  <Border Background="{StaticResource Panel2}"
                          CornerRadius="8"
                          Padding="12"
                          Margin="0,0,0,12">
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{StaticResource Muted}"
                               Text="If you are not the server owner, ask for the save folder instead: Level.sav plus the Players folder. Put both in the same local folder, then select Level.sav on the Save Data tab."/>
                  </Border>

                  <Label Content="Profile name"/>
                  <TextBox x:Name="ProfileName"/>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <Label Content="Host / IP"/>
                      <TextBox x:Name="Host"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                      <Label Content="SSH port"/>
                      <TextBox x:Name="Port" Text="22"/>
                    </StackPanel>
                  </Grid>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <Label Content="Username"/>
                      <TextBox x:Name="Username"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                      <Label Content="Authentication"/>
                      <ComboBox x:Name="Authentication" SelectionChanged="Authentication_SelectionChanged">
                        <ComboBoxItem Content="Password" IsSelected="True"/>
                        <ComboBoxItem Content="SSH key"/>
                      </ComboBox>
                    </StackPanel>
                  </Grid>

                  <StackPanel x:Name="PasswordPanel">
                    <Label Content="Password (encrypted locally with Windows DPAPI)"/>
                    <PasswordBox x:Name="Password"/>
                  </StackPanel>

                  <StackPanel x:Name="KeyPanel" Visibility="Collapsed">
                    <Label Content="Private SSH key path"/>
                    <DockPanel>
                      <Button DockPanel.Dock="Right"
                              Content="Browse"
                              Margin="8,0,0,0"
                              Click="PickKey_Click"/>
                      <TextBox x:Name="PrivateKeyPath"/>
                    </DockPanel>
                  </StackPanel>

                  <Label Content="Remote path to Level.sav"/>
                  <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="Find automatically"
                            Margin="8,0,0,0"
                            Click="FindRemoteSave_Click"/>
                    <TextBox x:Name="RemoteSavePath"
                             ToolTip="May be left empty. The application can search the server for Level.sav automatically."/>
                  </DockPanel>

                  <Label Content="Player name"/>
                  <TextBox x:Name="PlayerName" Text="Lanessear"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                  <Button Content="Save profile" Click="SaveProfile_Click"/>
                  <Button Content="Test connection" Click="TestConnection_Click"/>
                  <Button Content="Download save" Click="DownloadSave_Click"/>
                </WrapPanel>

                <Border Grid.Row="2"
                        Background="{StaticResource Panel2}"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,12,0,0">
                  <TextBlock x:Name="ServerStatus"
                             Text="No server action yet."
                             TextWrapping="Wrap"
                             Foreground="{StaticResource Muted}"/>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Maintenance">
        <Grid Margin="20">
          <Border Style="{StaticResource Card}" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel>
              <TextBlock Text="Updates and removal" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Margin="0,8,0,14"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource Muted}"
                         Text="Updates are downloaded from the latest GitHub release. Files no longer used by the new version are moved to a dated archive under %LOCALAPPDATA%\PalworldHelper\obsolete instead of being deleted immediately."/>
              <WrapPanel>
                <Button Content="Check for updates" Click="CheckForUpdates_Click"/>
                <Button Content="Create debug summary"
                        Click="CreateDebugSummary_Click"/>
                <Button Content="Uninstall PalworldHelper"
                        Margin="10,8,8,0"
                        Background="#FF8796"
                        Click="Uninstall_Click"/>
              </WrapPanel>
              <Border Background="{StaticResource Panel2}"
                      CornerRadius="8"
                      Padding="12"
                      Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="Obsolete update archive"
                             FontSize="16"
                             FontWeight="SemiBold"/>
                  <TextBlock Text="Old files moved during updates are kept here temporarily so you can inspect or remove them later."
                             TextWrapping="Wrap"
                             Foreground="{StaticResource Muted}"
                             Margin="0,6,0,10"/>
                  <TextBlock x:Name="ObsoleteStatus"
                             TextWrapping="Wrap"
                             Foreground="{StaticResource Muted}"
                             Margin="0,0,0,8"/>
                  <WrapPanel>
                    <Button Content="Open obsolete folder"
                            Click="OpenObsoleteFolder_Click"/>
                    <Button Content="Refresh"
                            Click="RefreshObsolete_Click"/>
                    <Button Content="Delete obsolete folder"
                            Background="#FF8796"
                            Click="DeleteObsolete_Click"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <TextBlock x:Name="MaintenanceStatus"
                         Margin="0,14,0,0"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource Muted}"/>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <DockPanel Grid.Row="4" Margin="0,12,0,0">
      <TextBlock DockPanel.Dock="Left"
                 Foreground="{StaticResource Muted}"
                 Text="PalworldHelper v0.6 · Settings are stored under %LOCALAPPDATA%\PalworldHelper"/>
      <TextBlock DockPanel.Dock="Right"
                 Foreground="{StaticResource Muted}"
                 Text="Portable app folder; data and parser helper remain replaceable."/>
    </DockPanel>
  </Grid>
</Window>
