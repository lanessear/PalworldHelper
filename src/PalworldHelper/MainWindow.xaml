<Window x:Class="PalworldHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PalworldHelper"
        Height="920"
        Width="1320"
        MinHeight="780"
        MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="292"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Background="{DynamicResource Sidebar}"
            Padding="20">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="PalworldHelper"
                     Foreground="White"
                     FontSize="26"
                     FontWeight="Bold"/>
          <TextBlock Text="Save-aware breeding planner"
                     Foreground="{DynamicResource SidebarMuted}"
                     TextWrapping="Wrap"
                     Margin="0,4,0,18"/>

          <Border Background="{DynamicResource DangerSoft}"
                  BorderBrush="{DynamicResource Danger}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="12"
                  Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="AI-created project"
                         Foreground="{DynamicResource Danger}"
                         FontWeight="ExtraBold"/>
              <TextBlock Text="AI designs, writes, documents, tests, and maintains this project. The human owner reviews and approves the results."
                         Foreground="{DynamicResource Text}"
                         TextWrapping="Wrap"
                         FontSize="12"
                         Margin="0,5,0,0"/>
              <TextBlock Text="Not presented as human-developed software."
                         Foreground="{DynamicResource Muted}"
                         FontStyle="Italic"
                         FontSize="12"
                         Margin="0,5,0,0"/>
            </StackPanel>
          </Border>

          <TextBlock Text="Navigation"
                     Foreground="{DynamicResource SidebarMuted}"
                     FontWeight="SemiBold"
                     Margin="0,0,0,2"/>
          <Button x:Name="ThemeToggleButton"
                  Content="🌙 Dark mode"
                  Style="{StaticResource NavButton}"
                  Click="ToggleTheme_Click"/>
          <Button Content="💾 Save Data"
                  Style="{StaticResource NavButton}"
                  Click="GoToSaveData_Click"/>
          <Button Content="🥚 Breeding Chain"
                  Style="{StaticResource NavButton}"
                  Click="GoToBreeding_Click"/>
          <Button Content="🖥 Server Import"
                  Style="{StaticResource NavButton}"
                  Click="GoToServerImport_Click"/>
          <Button Content="🛠 Maintenance"
                  Style="{StaticResource NavButton}"
                  Click="GoToMaintenance_Click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <Border Background="{DynamicResource SidebarPanel}"
                  CornerRadius="12"
                  Padding="14"
                  Margin="0,18,0,0">
            <StackPanel>
              <TextBlock Text="Session"
                         Foreground="White"
                         FontWeight="SemiBold"/>
              <TextBlock x:Name="DashboardSaveStatus"
                         Text="No save loaded"
                         Foreground="White"
                         TextWrapping="Wrap"
                         Margin="0,8,0,0"/>
              <TextBlock x:Name="DashboardCacheStatus"
                         Text="Select or auto-find Level.sav"
                         Foreground="{DynamicResource SidebarMuted}"
                         TextWrapping="Wrap"
                         FontSize="12"
                         Margin="0,3,0,0"/>
              <Separator Margin="0,10,0,10"/>
              <TextBlock Text="Owner"
                         Foreground="{DynamicResource SidebarMuted}"
                         FontSize="12"/>
              <TextBlock x:Name="DashboardOwnerStatus"
                         Text="All owners"
                         Foreground="White"
                         TextWrapping="Wrap"/>
              <TextBlock Text="Breeding data"
                         Foreground="{DynamicResource SidebarMuted}"
                         FontSize="12"
                         Margin="0,8,0,0"/>
              <TextBlock x:Name="DashboardBreedingStatus"
                         Text="Loading default data"
                         Foreground="White"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <TextBlock Text="Local-first. No Python install required."
                     Foreground="{DynamicResource SidebarMuted}"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Margin="0,12,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1"
          Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Style="{StaticResource Card}"
              Background="{DynamicResource Panel}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Command Center"
                       FontSize="30"
                       FontWeight="Bold"/>
            <TextBlock x:Name="DashboardNextAction"
                       Text="Load a save or plan without restrictions."
                       Foreground="{DynamicResource Muted}"
                       FontSize="15"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
          </StackPanel>
          <WrapPanel Grid.Column="1"
                     VerticalAlignment="Center">
            <Button Content="Find save"
                    Style="{StaticResource PrimaryButton}"
                    Click="FindLocalSave_Click"/>
            <Button Content="Plan breeding"
                    Style="{StaticResource SecondaryButton}"
                    Click="GoToBreeding_Click"/>
            <Button Content="Debug summary"
                    Style="{StaticResource SecondaryButton}"
                    Click="CreateDebugSummary_Click"/>
          </WrapPanel>
        </Grid>
      </Border>

      <TabControl x:Name="MainTabs"
                  Grid.Row="1"
                  Margin="0,16,0,0"
                  Background="Transparent"
                  BorderThickness="0">
        <TabControl.ItemContainerStyle>
          <Style TargetType="TabItem">
            <Setter Property="Visibility" Value="Collapsed"/>
          </Style>
        </TabControl.ItemContainerStyle>

        <TabItem Header="Save Data">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Your Palworld Save"
                             FontSize="22"
                             FontWeight="SemiBold"/>
                  <TextBlock Text="For local worlds, auto-find usually detects Level.sav and matching player data. For servers, use Level.sav plus Players and DPS files when available."
                             Foreground="{DynamicResource Muted}"
                             TextWrapping="Wrap"
                             Margin="0,6,0,0"/>
                  <TextBox x:Name="LocalSavePath"
                           IsReadOnly="True"
                           Margin="0,14,0,0"/>
                  <TextBlock x:Name="SaveStatus"
                             Foreground="{DynamicResource Muted}"
                             TextWrapping="Wrap"
                             Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            MinWidth="190">
                  <Button Content="Find automatically"
                          Style="{StaticResource PrimaryButton}"
                          Click="FindLocalSave_Click"/>
                  <Button Content="Select Level.sav"
                          Style="{StaticResource SecondaryButton}"
                          Click="PickLocalSave_Click"/>
                  <Button Content="Refresh save data"
                          Style="{StaticResource SecondaryButton}"
                          Click="RefreshSaveData_Click"/>
                </StackPanel>
              </Grid>
            </Border>

            <UniformGrid Grid.Row="1"
                         Columns="4"
                         Margin="0,14,0,14">
              <Border Style="{StaticResource StatCard}">
                <StackPanel>
                  <TextBlock Text="Owners in view" Foreground="{DynamicResource Muted}"/>
                  <TextBlock x:Name="SavePlayerCount" Text="—" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource StatCard}">
                <StackPanel>
                  <TextBlock Text="Owned Pals" Foreground="{DynamicResource Muted}"/>
                  <TextBlock x:Name="SavePalCount" Text="—" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource StatCard}">
                <StackPanel>
                  <TextBlock Text="Species" Foreground="{DynamicResource Muted}"/>
                  <TextBlock x:Name="SaveSpeciesCount" Text="—" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource StatCard}" Margin="0">
                <StackPanel>
                  <TextBlock Text="Passive Skills" Foreground="{DynamicResource Muted}"/>
                  <TextBlock x:Name="SavePassiveCount" Text="—" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
              </Border>
            </UniformGrid>

            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <GroupBox Header="Players">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Bottom"
                             x:Name="SaveOwnerFilterStatus"
                             Text="Click a player to filter owned Pals."
                             Foreground="{DynamicResource Muted}"
                             Margin="8,8,8,0"/>
                  <ListView x:Name="SavePlayersList"
                            SelectionChanged="SavePlayersList_SelectionChanged"
                            GridViewColumnHeader.Click="GridViewColumnHeader_Click">
                    <ListView.View>
                      <GridView>
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="170"/>
                        <GridViewColumn Header="Level" DisplayMemberBinding="{Binding Level}" Width="65"/>
                        <GridViewColumn Header="UID" DisplayMemberBinding="{Binding PlayerUid}" Width="250"/>
                      </GridView>
                    </ListView.View>
                  </ListView>
                </DockPanel>
              </GroupBox>

              <GroupBox Grid.Column="1"
                        Header="Owned Pals"
                        Margin="14,0,0,0">
                <DockPanel>
                  <Button DockPanel.Dock="Bottom"
                          Content="Show all owners"
                          Style="{StaticResource SecondaryButton}"
                          Click="ShowAllOwners_Click"
                          HorizontalAlignment="Left"
                          Margin="8,8,0,0"/>
                  <ListView x:Name="SavePalsList"
                            GridViewColumnHeader.Click="GridViewColumnHeader_Click">
                    <ListView.View>
                      <GridView>
                        <GridViewColumn Header="Species" DisplayMemberBinding="{Binding Species}" Width="140"/>
                        <GridViewColumn Header="Nickname" DisplayMemberBinding="{Binding Nickname}" Width="130"/>
                        <GridViewColumn Header="Owner" DisplayMemberBinding="{Binding Owner}" Width="140"/>
                        <GridViewColumn Header="Storage" DisplayMemberBinding="{Binding Storage}" Width="160"/>
                        <GridViewColumn Header="Level" DisplayMemberBinding="{Binding Level}" Width="60"/>
                        <GridViewColumn Header="Gender" DisplayMemberBinding="{Binding Gender}" Width="80"/>
                        <GridViewColumn Header="Passives" DisplayMemberBinding="{Binding PassiveSkills}" Width="360"/>
                      </GridView>
                    </ListView.View>
                  </ListView>
                </DockPanel>
              </GroupBox>
            </Grid>

            <Expander Grid.Row="3"
                      Header="Technical details"
                      Margin="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <GroupBox Header="File and parser information" Margin="0,0,8,0">
                  <TextBox x:Name="SaveMetadata"
                           IsReadOnly="True"
                           TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto"
                           MinHeight="120"
                           Padding="8"
                           FontFamily="Consolas"/>
                </GroupBox>
                <GroupBox Header="Header / hex preview" Grid.Column="1" Margin="8,0,0,0">
                  <TextBox x:Name="SaveHexPreview"
                           IsReadOnly="True"
                           TextWrapping="NoWrap"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto"
                           MinHeight="120"
                           Padding="8"
                           FontFamily="Consolas"/>
                </GroupBox>
              </Grid>
            </Expander>
          </Grid>
        </TabItem>

        <TabItem Header="Breeding Chain">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <Border x:Name="BreedingDataKindBadge"
                          DockPanel.Dock="Left"
                          Background="{DynamicResource Primary}"
                          CornerRadius="6"
                          Padding="8,3"
                          Margin="0,0,8,0">
                    <TextBlock x:Name="BreedingDataKindText"
                               Text="Default"
                               Foreground="White"
                               FontWeight="SemiBold"/>
                  </Border>
                  <TextBlock x:Name="BreedingStatus"
                             Foreground="{DynamicResource Muted}"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center"/>
                </DockPanel>

                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <Label Content="Optional owned source Pal"/>
                    <ComboBox x:Name="StartPal" IsEditable="True" IsTextSearchEnabled="True" DisplayMemberPath="DisplayName"/>
                    <TextBlock Text="Leave empty to search from any available Pal."
                               Foreground="{DynamicResource Muted}"
                               FontSize="12"
                               Margin="0,5,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <Label Content="Desired child Pal"/>
                    <ComboBox x:Name="TargetPal" IsEditable="True" IsTextSearchEnabled="True" DisplayMemberPath="DisplayName"/>
                    <TextBlock Text="Pick the target first."
                               Foreground="{DynamicResource Muted}"
                               FontSize="12"
                               Margin="0,5,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="14,0,0,0">
                    <Label Content="Desired passive skills"/>
                    <DockPanel>
                      <Button DockPanel.Dock="Right"
                              Content="Add"
                              Padding="10,5"
                              Margin="8,0,0,0"
                              Click="AddPassiveSkill_Click"/>
                      <ComboBox x:Name="PassiveSkillPicker"
                                IsEditable="True"
                                IsTextSearchEnabled="True"
                                DisplayMemberPath="DisplayName"/>
                    </DockPanel>
                    <WrapPanel x:Name="PassiveSkillTags" Margin="0,8,0,0"/>
                    <TextBlock x:Name="PassiveSkillLimitStatus"
                               Text="0/4 passive skills selected. Cleaner parents with fewer extra passives are ranked higher."
                               Foreground="{DynamicResource Muted}"
                               FontSize="12"
                               Margin="0,5,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="3" Margin="14,0,0,0">
                    <Label Content="Gender conversions"/>
                    <ComboBox x:Name="GenderConversionBudget" SelectedIndex="0">
                      <ComboBoxItem Content="0"/>
                      <ComboBoxItem Content="1"/>
                      <ComboBoxItem Content="2"/>
                    </ComboBox>
                    <TextBlock Text="Uses gender-change items."
                               Foreground="{DynamicResource Muted}"
                               FontSize="12"
                               Margin="0,5,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="4"
                          Content="Find best chain"
                          Style="{StaticResource PrimaryButton}"
                          VerticalAlignment="Top"
                          Margin="14,25,0,0"
                          Click="FindPath_Click"/>
                </Grid>

                <Expander Header="Saved breeding goals"
                          IsExpanded="False"
                          Margin="0,16,0,0">
                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="BreedingWishlistList"
                             MinHeight="92"
                             MaxHeight="150"
                             SelectionChanged="BreedingWishlistList_SelectionChanged"/>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                      <Button Content="Save current goal" Click="SaveBreedingGoal_Click"/>
                      <Button Content="Load selected" Click="LoadBreedingGoal_Click"/>
                      <Button Content="Remove selected" Style="{StaticResource DangerButton}" Click="RemoveBreedingGoal_Click"/>
                    </StackPanel>
                  </Grid>
                </Expander>

                <Expander Header="Advanced: breeding data source"
                          IsExpanded="False"
                          Margin="0,12,0,0">
                  <StackPanel>
                    <TextBlock Text="The bundled default is normally correct. Use a custom JSON only when the game changes breeding rules or you are testing another dataset."
                               Foreground="{DynamicResource Muted}"
                               TextWrapping="Wrap"/>
                    <DockPanel Margin="0,12,0,0">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="JSON format info" Click="ShowBreedingJsonInfo_Click"/>
                        <Button Content="Use Default" Click="UseBundledBreedingData_Click"/>
                        <Button Content="Select JSON" Click="PickBreedingJson_Click"/>
                      </StackPanel>
                      <TextBox x:Name="BreedingJsonPath" IsReadOnly="True"/>
                    </DockPanel>
                  </StackPanel>
                </Expander>

                <Expander Header="Passive inheritance notes"
                          IsExpanded="False"
                          Margin="0,12,0,0">
                  <TextBlock Margin="0,8,0,0"
                             Foreground="{DynamicResource Muted}"
                             TextWrapping="Wrap"
                             Text="Palworld combines both parents' passive skills, removes duplicates, then rolls how many parent passives the child inherits: 1 = 40%, 2 = 30%, 3 = 20%, 4 = 10%. A second roll can add random passives if empty slots remain. PalworldHelper ranks owned parent pairs by the estimated chance to hatch the exact desired passive set without extra random passives. Clean parents are better: together they should carry the desired passives and as few unwanted passives as possible. Duplicate passives on both parents do not improve the odds.&#x0a;&#x0a;Sources checked 2026-07-26: Palworld Wiki.gg – Breeding, section “Passing Down Passive Skills” (https://palworld.wiki.gg/wiki/Breeding); Palworld Wiki.gg – Passive Skills, section “Acquisition / Breeding” (https://palworld.wiki.gg/wiki/Passive_Skills)."/>
                </Expander>
              </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="1*"/>
              </Grid.ColumnDefinitions>
              <GroupBox Header="Breeding Chain Results">
                <ListBox x:Name="ResultList"
                         Background="{DynamicResource Panel}"
                         Foreground="{DynamicResource Text}"
                         BorderBrush="{DynamicResource Border}"
                         FontSize="16"
                         Padding="10"
                         SelectionChanged="ResultList_SelectionChanged"/>
              </GroupBox>
              <GroupBox Grid.Column="1"
                        Header="Best Parent Details"
                        Margin="14,0,0,0">
                <TextBox x:Name="ParentDetails"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="14"
                         FontSize="14"
                         Text="Click a breeding result to inspect owned parent candidates."/>
              </GroupBox>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem Header="Optional Server Import">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="310"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock Text="Server Profiles" FontSize="22" FontWeight="SemiBold"/>
                  <TextBlock Text="Optional. Useful for server owners or shared servers."
                             Foreground="{DynamicResource Muted}"
                             TextWrapping="Wrap"
                             Margin="0,6,0,0"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                  <Button Content="New" Click="NewProfile_Click"/>
                  <Button Content="Delete" Style="{StaticResource DangerButton}" Click="DeleteProfile_Click"/>
                </WrapPanel>
                <ListBox x:Name="ProfilesList"
                         SelectionChanged="ProfilesList_SelectionChanged"
                         Margin="0,12,0,0"/>
              </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource Card}"
                    Margin="14,0,0,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <TextBlock Text="Connection"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Download Level.sav from a server via SSH/SFTP. Local players can ignore this page."
                               Foreground="{DynamicResource Muted}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,12"/>
                    <Border Background="{DynamicResource WarningSoft}"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,12">
                      <TextBlock Text="Tip: download Level.sav together with the Players folder from the same save directory so ownership and storage data stay complete."
                                 Foreground="{DynamicResource Text}"
                                 TextWrapping="Wrap"/>
                    </Border>

                    <Label Content="Profile name"/>
                    <TextBox x:Name="ProfileName"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <Label Content="Host"/>
                        <TextBox x:Name="Host"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <Label Content="Port"/>
                        <TextBox x:Name="Port" Text="22"/>
                      </StackPanel>
                    </Grid>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <Label Content="Username"/>
                        <TextBox x:Name="Username"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <Label Content="Authentication"/>
                        <ComboBox x:Name="Authentication" SelectionChanged="Authentication_SelectionChanged">
                          <ComboBoxItem Content="Password" IsSelected="True"/>
                          <ComboBoxItem Content="PrivateKey"/>
                        </ComboBox>
                      </StackPanel>
                    </Grid>
                    <StackPanel x:Name="PasswordPanel">
                      <Label Content="Password"/>
                      <PasswordBox x:Name="Password"/>
                    </StackPanel>
                    <StackPanel x:Name="KeyPanel" Visibility="Collapsed">
                      <Label Content="Private key path"/>
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Select key" Click="PickKey_Click"/>
                        <TextBox x:Name="PrivateKeyPath"/>
                      </DockPanel>
                    </StackPanel>
                    <Label Content="Remote Level.sav path"/>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Find save" Click="FindRemoteSave_Click"/>
                      <TextBox x:Name="RemoteSavePath"
                               ToolTip="Example: /home/steam/.../Saved/SaveGames/0/world-id/Level.sav"/>
                    </DockPanel>
                    <Label Content="Your player name"/>
                    <TextBox x:Name="PlayerName" Text="Lanessear"/>
                  </StackPanel>
                </ScrollViewer>
                <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                  <Button Content="Save profile" Style="{StaticResource PrimaryButton}" Click="SaveProfile_Click"/>
                  <Button Content="Test connection" Style="{StaticResource SecondaryButton}" Click="TestConnection_Click"/>
                  <Button Content="Download save" Style="{StaticResource SecondaryButton}" Click="DownloadSave_Click"/>
                </WrapPanel>
                <Border Grid.Row="2"
                        Background="{DynamicResource Panel2}"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,12,0,0">
                  <TextBlock x:Name="ServerStatus"
                             Foreground="{DynamicResource Muted}"
                             TextWrapping="Wrap"/>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="Maintenance">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.1*"/>
              <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Maintenance"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Updates, diagnostics, and safe cleanup tools."
                           Foreground="{DynamicResource Muted}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,12"/>
                <WrapPanel>
                  <Button Content="Check for updates" Click="CheckForUpdates_Click"/>
                  <Button Content="Create debug summary" Style="{StaticResource PrimaryButton}" Click="CreateDebugSummary_Click"/>
                  <Button Content="Uninstall PalworldHelper" Style="{StaticResource DangerButton}" Click="Uninstall_Click"/>
                </WrapPanel>
                <TextBlock x:Name="MaintenanceStatus"
                           Foreground="{DynamicResource Muted}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    Style="{StaticResource Card}"
                    Margin="14,0,0,0">
              <StackPanel>
                <TextBlock Text="Obsolete update archive"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="ObsoleteStatus"
                           Foreground="{DynamicResource Muted}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,10"/>
                <WrapPanel>
                  <Button Content="Open obsolete folder" Click="OpenObsoleteFolder_Click"/>
                  <Button Content="Refresh" Click="RefreshObsolete_Click"/>
                  <Button Content="Delete obsolete folder" Style="{StaticResource DangerButton}" Click="DeleteObsolete_Click"/>
                </WrapPanel>
                <TextBlock Text="This only removes old files archived during updates. Current app files, saves, settings, and custom JSON files are not deleted."
                           Foreground="{DynamicResource Muted}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </TabItem>
      </TabControl>

      <DockPanel Grid.Row="2"
                 Margin="0,12,0,0">
        <TextBlock DockPanel.Dock="Left"
                   Foreground="{DynamicResource Muted}"
                   Text="PalworldHelper reads local files only unless you explicitly download from a configured server."/>
        <TextBlock DockPanel.Dock="Right"
                   Foreground="{DynamicResource Muted}"
                   Text="Complete release folder: EXE + JSON + parser folder"/>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
