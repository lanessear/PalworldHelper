<Application x:Class="PalworldHelper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#EEF2F7"/>
    <SolidColorBrush x:Key="Panel" Color="#FBFCFE"/>
    <SolidColorBrush x:Key="Panel2" Color="#E7ECF3"/>
    <SolidColorBrush x:Key="Input" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Text" Color="#172033"/>
    <SolidColorBrush x:Key="Muted" Color="#61708A"/>
    <SolidColorBrush x:Key="Accent" Color="#7DD3C7"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#DDF7F3"/>
    <SolidColorBrush x:Key="Primary" Color="#3B82F6"/>
    <SolidColorBrush x:Key="PrimarySoft" Color="#DCEBFF"/>
    <SolidColorBrush x:Key="Danger" Color="#FCA5A5"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="WarningSoft" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="Border" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Sidebar" Color="#111827"/>
    <SolidColorBrush x:Key="SidebarMuted" Color="#A7B4C8"/>
    <SolidColorBrush x:Key="SidebarPanel" Color="#1F2937"/>

    <Style TargetType="Window">
      <Setter Property="Background" Value="{DynamicResource Bg}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>
    <Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Margin" Value="0,6,0,3"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Padding" Value="9"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Padding" Value="9"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Padding" Value="7"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/></Style>
    <Style TargetType="ListView"><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,8,8,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Primary}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="18,10"/>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource PrimarySoft}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Danger}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource SidebarPanel}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="Margin" Value="0,7,0,0"/>
    </Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="16,8"/></Style>
    <Style TargetType="GroupBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Background" Value="{DynamicResource Panel2}"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    <Style x:Key="DashboardCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Background" Value="{DynamicResource Panel2}"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="MinHeight" Value="92"/>
    </Style>
    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
  </Application.Resources>
</Application>
